# .env.example
# Copia este archivo como .env.local para desarrollo web normal, o como
# .env.production antes de construir la versión para Capacitor/Android.

# ⚠️ CRÍTICO PARA CAPACITOR (lección aprendida en Zebcytec):
# En el navegador, dejar esto vacío funciona porque las rutas relativas
# ("/api/tutor") resuelven contra el mismo dominio automáticamente.
# Pero dentro del WebView nativo de Android/iOS, el origen es
# "capacitor://localhost", así que una ruta relativa NUNCA llega a tu backend
# real. Antes de ejecutar `npx cap sync`, esta variable DEBE apuntar a tu
# dominio real de producción en Vercel:
VITE_API_URL=https://tuprofeencasa.com

# Recuerda: cualquier variable con prefijo VITE_ queda expuesta en el
# bundle final (visible para cualquiera que inspeccione la app). Por eso
# VITE_API_URL es seguro (es solo una URL pública), pero NUNCA pongas aquí
# claves secretas como ANTHROPIC_API_KEY o SUPABASE_SERVICE_ROLE_KEY —
# esas van SOLO en las variables de entorno del proyecto en Vercel,
# nunca con prefijo VITE_, nunca en este archivo.
